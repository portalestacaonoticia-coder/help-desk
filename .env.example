# ---- Banco ----
# Dev local (docker compose): postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# Prod: connection string do Neon (com ?sslmode=require)
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# ---- Auth (NextAuth / Auth.js v5) ----
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# URL pública da app (em dev pode omitir; em prod defina a URL do Vercel)
NEXTAUTH_URL=http://localhost:3000

# ---- Criptografia das credenciais das caixas (AES-256-GCM) ----
# 32 bytes em base64. Gere com o mesmo comando do NEXTAUTH_SECRET.
# TROCAR esta chave invalida todas as senhas de caixa já cifradas no banco.
ENCRYPTION_KEY=

# ---- Anthropic (usado só nas Fases 3-4; deixe vazio por enquanto) ----
ANTHROPIC_API_KEY=

# ---- Proteção do endpoint de cron ----
# O Vercel Cron envia "Authorization: Bearer <CRON_SECRET>". Gere um valor aleatório.
CRON_SECRET=

# As 6 caixas NÃO ficam em env: são gerenciadas na tabela `mailboxes` (senhas cifradas).
# Use o script de seed ou o dashboard para cadastrá-las.
